aneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1100" height="290" as="geometry"/></mxCell><mxCell id="c21" value="1) 위 → 아래 (깊이별 병렬)&lt;br&gt;같은 깊이의 폴더를 FindFirstFileEx 로 열거&lt;br&gt;파일은 열거 결과로 바로 삭제" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c20"><mxGeometry x="15" y="45" width="250" height="90" as="geometry"/></mxCell><mxCell id="c22" value="2) 아래 → 위&lt;br&gt;가장 깊은 폴더부터 RemoveDirectory&lt;br&gt;(같은 깊이끼리는 병렬)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c20"><mxGeometry x="290" y="45" width="250" height="90" as="geometry"/></mxCell><mxCell id="c23" value="큰 폴더 하나에 파일 수만 개&lt;br&gt;1,024건 이상이면 그 안에서도&lt;br&gt;512개씩 나눠 병렬 삭제" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c20"><mxGeometry x="565" y="45" width="240" height="90" as="geometry"/></mxCell><mxCell id="c24" value="Junction · 심볼릭 링크&lt;br&gt;따라가지 않고 링크만 삭제&lt;br&gt;(대상 폴더는 그대로)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c20"><mxGeometry x="830" y="45" width="250" height="90" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="실패 시 재시도 사다리" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;horizontal=1;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="c20"><mxGeometry x="15" y="155" width="1065" height="120" as="geometry"/></mxCell><mxCell id="c27" value="① DeleteFile / RemoveDirectory" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c26"><mxGeometry x="15" y="42" width="240" height="60" as="geometry"/></mxCell><mxCell id="c28" value="② 읽기 전용·시스템·숨김 속성 해제 후 재시도" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c26"><mxGeometry x="290" y="42" width="280" height="60" as="geometry"/></mxCell><mxCell id="c29" value="③ POSIX 삭제 시맨틱 (FileDispositionInfoEx)&lt;br&gt;읽기 전용 무시 · FILE_SHARE_DELETE 로 열린 파일도 제거" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c26"><mxGeometry x="605" y="42" width="440" height="60" as="geometry"/></mxCell><mxCell id="c30" value="접근 거부" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="그래도 실패" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="병렬도: SSD/NVMe = 코어 수(상한 12), HDD = 2 · &quot;\\?\&quot; 접두사로 260자 초과 경로 지원 · 60,000 파일 50.5초 → 4.2초" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="745" width="1100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>