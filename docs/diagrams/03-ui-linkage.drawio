<mxfile host="app.diagrams.net"><diagram name="화면 구조와 폴더-Treemap 연동" id="d1"><mxGraphModel dx="1140" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="탭 (순서 = LiveTab 열거형 = SelectedIndex)" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;horizontal=1;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="80" as="geometry"/></mxCell><mxCell id="c3" value="0  폴더" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="c2"><mxGeometry x="20" y="38" width="190" height="32" as="geometry"/></mxCell><mxCell id="c4" value="1  Treemap" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="c2"><mxGeometry x="225" y="38" width="190" height="32" as="geometry"/></mxCell><mxCell id="c5" value="2  큰 파일" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c2"><mxGeometry x="430" y="38" width="190" height="32" as="geometry"/></mxCell><mxCell id="c6" value="3  파일 유형" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c2"><mxGeometry x="635" y="38" width="190" height="32" as="geometry"/></mxCell><mxCell id="c7" value="4  정리 추천" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c2"><mxGeometry x="840" y="38" width="190" height="32" as="geometry"/></mxCell><mxCell id="c8" value="NavBar (폴더·Treemap 탭에서만 보임):  ◀ 뒤로  ▶ 앞으로  ▲ 상위  루트  |  경로 막대(breadcrumb)  |  [분할 보기] 토글&lt;br&gt;&lt;font style=&quot;font-weight:normal&quot;&gt;이 버튼들과 경로 클릭도 모두 아래 MainViewModel.Navigate(id) 로 이어진다&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d0f0ee;strokeColor=#3a9d96;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1100" height="54" as="geometry"/></mxCell><mxCell id="c9" value="SplitHost — 분할 보기 ON: 두 패널이 나란히 / OFF: 탭이 고른 쪽 하나만" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;horizontal=1;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c10" value="FolderPanel&lt;br&gt;ListView (Rows) · 다중 선택 · 삭제&lt;br&gt;정렬은 ViewModel 이 담당 (바인딩 유지)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="c9"><mxGeometry x="20" y="42" width="400" height="140" as="geometry"/></mxCell><mxCell id="c11" value="Grid&lt;br&gt;Splitter" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=9;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c9"><mxGeometry x="535" y="134" width="30" height="48" as="geometry"/></mxCell><mxCell id="c12" value="TreemapPanel&lt;br&gt;TreemapControl (squarified · 최대 4단계 · 카테고리 7색)&lt;br&gt;선택 강조 테두리" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="c9"><mxGeometry x="680" y="42" width="400" height="140" as="geometry"/></mxCell><mxCell id="c13" value="MainViewModel&lt;br&gt;_currentDirId = 위치 상태는 &lt;b&gt;하나뿐&lt;/b&gt;&lt;br&gt;Navigate(id) → Rows · CurrentPath · Breadcrumb 갱신 → ViewRefreshed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="500" height="70" as="geometry"/></mxCell><mxCell id="c14" value="폴더 더블클릭 → Navigate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#3d6aa8;fontSize=11;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="폴더 더블클릭 → Navigate (탭 유지)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#3d6aa8;fontSize=11;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;dashed=1;exitX=0.02;exitY=0;entryX=0.6;entryY=1;" edge="1" parent="1" source="c13" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="ViewRefreshed → 다시 그림" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#555555;fontSize=11;endArrow=block;endFill=1;dashed=1;exitX=0.98;exitY=0;entryX=0.4;entryY=1;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="목록 선택 → 강조" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#b36b00;fontSize=11;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Treemap 클릭 → 선택" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#b36b00;fontSize=11;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.55;entryX=1;entryY=0.55;" edge="1" parent="1" source="c12" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;선택 동기화 규칙&lt;/b&gt;: Treemap 은 여러 단계를 겹쳐 그리므로 깊은 사각형을 누르면 &quot;현재 폴더 바로 아래에서 그것을 품은 항목&quot;을 목록에서 선택한다 (NodeStore.ChildOnPathTo).&lt;br&gt;검색 결과를 보는 중에는 목록이 폴더 내용이 아니므로 선택 동기화를 하지 않는다. 스캔 중에는 NodeStore 를 직접 읽지 않고 스냅샷 1단계 Treemap 만 그린다." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#555555;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1100" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>