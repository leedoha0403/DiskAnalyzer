<UserControl x:Class="DiskAnalyzer.App.Views.QuickMovePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:qm="clr-namespace:DiskAnalyzer.App.ViewModels.QuickMove"
             xmlns:km="clr-namespace:DiskAnalyzer.App.Keymaps"
             Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 내비게이션 아이콘 버튼: 기존 LinkButton 스타일을 그대로 쓰고 크기만 맞춘다. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 빠른 위치 버튼 -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="AllowDrop" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaneListItem" TargetType="ListViewItem" BasedOn="{StaticResource DataListItem}">
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Style.Triggers>
                <!-- P0 보호 항목은 흐리게 보여서 "옮길 수 없는 항목"임을 알린다. -->
                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="EntryNameCell">
            <StackPanel Orientation="Horizontal">
                <Border Width="9" Height="9" CornerRadius="2" Margin="2,0,9,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource FileIconBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource FolderIconBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Glyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}" FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EntrySizeCell">
            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                       HorizontalAlignment="Right" Margin="0,0,10,0" />
        </DataTemplate>

        <DataTemplate x:Key="EntryDateCell">
            <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Numeric}"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- 드롭 대상: 패널 전체. 끌어 오면 테두리와 배경이 강조되고 안내 문구가 뜬다. -->
    <Border x:Name="Root" CornerRadius="8" BorderThickness="1" AllowDrop="True"
            DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 제목 / 드라이브 -->
            <DockPanel x:Name="TitleRow" Grid.Row="0" Margin="14,10,14,0">
                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding HasVolumeTag, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding VolumeTag}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding DriveName}" Style="{StaticResource Caption}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- 뒤로 / 앞으로 / 상위 / Breadcrumb / 최근 / 즐겨찾기 -->
            <Grid x:Name="NavRow" Grid.Row="1" Margin="10,8,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Content="◀" Command="{Binding BackCommand}" Style="{StaticResource NavButton}"
                            km:ShortcutHint.Command="Navigation.GoBack" km:ShortcutHint.Text="뒤로"
                            AutomationProperties.AutomationId="PaneBack" />
                    <Button x:Name="ForwardButton" Content="▶" Command="{Binding ForwardCommand}" Style="{StaticResource NavButton}"
                            km:ShortcutHint.Command="Navigation.GoForward" km:ShortcutHint.Text="앞으로"
                            AutomationProperties.AutomationId="PaneForward" />
                    <Button Content="▲" Command="{Binding UpCommand}" Style="{StaticResource NavButton}"
                            km:ShortcutHint.Command="Navigation.GoParentAlt" km:ShortcutHint.Text="상위 폴더"
                            AutomationProperties.AutomationId="PaneUp" />
                    <Button x:Name="RefreshButton" Content="⟳" Command="{Binding RefreshCommand}" Style="{StaticResource NavButton}"
                            km:ShortcutHint.Command="View.Refresh" km:ShortcutHint.Text="새로고침" />
                </StackPanel>

                <!-- Breadcrumb ↔ 경로 입력. 빈 곳을 누르거나 Ctrl+L 을 누르면 입력 모드로 바뀐다. -->
                <Border x:Name="PathHost" Grid.Column="1" CornerRadius="6" Height="30" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                        MouseLeftButtonUp="OnPathHostClick"
                        km:ShortcutHint.Command="Navigation.FocusPath" km:ShortcutHint.Text="빈 곳을 눌러 경로를 직접 입력">
                    <Grid>
                        <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Background="Transparent">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingPath}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Breadcrumb}" Margin="4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding Name}" Tag="{Binding Path}" Click="OnCrumbClick"
                                                    Style="{StaticResource LinkButton}" Padding="6,2" />
                                            <TextBlock Text="›" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                                                       Margin="1,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBox x:Name="PathBox" Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,3" FontSize="12.5" VerticalContentAlignment="Center"
                                 PreviewKeyDown="OnPathKeyDown" LostKeyboardFocus="OnPathLostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingPath}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- 입력 중인 경로의 아래 폴더 제안. 키보드 포커스는 입력 칸에 그대로 두고 ↑↓ / Tab 으로 고른다. -->
                        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=PathHost}" Placement="Bottom"
                               IsOpen="{Binding HasSuggestions, Mode=OneWay}" StaysOpen="True" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushStrong}"
                                    BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, ElementName=PathHost}">
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding Suggestions}" SelectedIndex="{Binding SuggestionIndex, Mode=OneWay}"
                                             Background="Transparent" BorderThickness="0" Focusable="False" MaxHeight="264"
                                             PreviewMouseLeftButtonUp="OnSuggestionClick"
                                             AutomationProperties.AutomationId="PathSuggestions">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" CornerRadius="4" Padding="9,5" Background="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,9,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource FolderIconBrush}" />
                                                    <TextBlock Text="{Binding}" FontSize="12.5" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Tab 자동완성 · ↑↓ 고르기 · Enter 이동 · Esc 취소" Style="{StaticResource Caption}"
                                               Margin="9,4,9,2" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Content="✎" Style="{StaticResource NavButton}" Margin="4,0,0,0" FontSize="14"
                        Command="{Binding BeginEditPathCommand}"
                        km:ShortcutHint.Command="Navigation.FocusPath" km:ShortcutHint.Text="경로 직접 입력 — 붙여넣기, Tab 자동완성"
                        AutomationProperties.AutomationId="PaneEditPath" />
                <Button Grid.Column="3" Content="▼" Style="{StaticResource NavButton}" Margin="0"
                        ToolTip="최근 위치" Click="OnRecentClick" />
                <Button Grid.Column="4" Style="{StaticResource NavButton}" Command="{Binding ToggleFavoriteCommand}"
                        ToolTip="즐겨찾기에 추가 / 제거" AutomationProperties.AutomationId="PaneFavorite">
                    <TextBlock FontSize="15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="☆" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Text" Value="★" />
                                        <Setter Property="Foreground" Value="{DynamicResource FolderIconBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- ★ 빠른 위치 -->
            <StackPanel x:Name="ChipsPanel" Grid.Row="2" Margin="14,8,14,0">
                <TextBlock Text="★ 빠른 위치" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="62" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Locations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type qm:QuickLocation}">
                                <Button Content="{Binding Name}" Tag="{Binding Path}" ToolTip="{Binding ToolTip}"
                                        Style="{StaticResource ChipButton}" Click="OnChipClick"
                                        MouseRightButtonUp="OnChipRightClick"
                                        DragEnter="OnChipDragOver" DragOver="OnChipDragOver"
                                        DragLeave="OnChipDragLeave" Drop="OnChipDrop" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- 안내(찾을 수 없는 경로 등) -->
            <TextBlock Grid.Row="3" Text="{Binding Notice}" Margin="14,4,14,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}" FontSize="11.5"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

            <!-- 파일 목록 -->
            <Grid x:Name="ListArea" Grid.Row="4" Margin="0,8,0,0">
                <ListView x:Name="ItemList" AutomationProperties.AutomationId="QuickMoveList"
                          Style="{StaticResource DataList}" ItemsSource="{Binding Entries}"
                          ItemContainerStyle="{StaticResource PaneListItem}"
                          SelectionMode="Extended" AllowDrop="False"
                          SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick"
                          GridViewColumnHeader.Click="OnHeaderClick" SizeChanged="OnListSizeChanged"
                          PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                          PreviewMouseLeftButtonUp="OnListMouseUp" PreviewMouseRightButtonDown="OnListRightDown">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="OnMenuOpened">
                            <MenuItem x:Name="MenuOpen" Header="열기" Click="OnMenuOpen" />
                            <MenuItem x:Name="MenuReveal" Header="폴더 위치 열기" Click="OnMenuReveal" />
                            <MenuItem x:Name="MenuQueue" Header="빠른 이동 대기열에 추가" Click="OnMenuQueue" />
                            <Separator x:Name="MenuFolderSeparator" />
                            <MenuItem x:Name="MenuUseDest" Header="이 폴더를 목적지로 사용" Click="OnMenuUseDest" />
                            <MenuItem x:Name="MenuFavorite" Header="즐겨찾기에 추가" Click="OnMenuFavorite" />
                            <Separator />
                            <MenuItem Header="경로 복사" Click="OnMenuCopyPath" />
                            <MenuItem x:Name="MenuName" Header="이름 복사" Click="OnMenuCopyName" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="NameColumn" Width="240" CellTemplate="{StaticResource EntryNameCell}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="이름" Tag="name" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn x:Name="SizeColumn" Width="96" CellTemplate="{StaticResource EntrySizeCell}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="크기" Tag="size" HorizontalContentAlignment="Right" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn x:Name="DateColumn" Width="128" CellTemplate="{StaticResource EntryDateCell}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="수정일" Tag="modified" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn x:Name="TypeColumn" Width="90" DisplayMemberBinding="{Binding TypeText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="유형" Tag="type" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 상태 표시: 불러오는 중 / 비어 있음 / 접근 불가 / 오류 -->
                <TextBlock Text="폴더를 불러오는 중..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="이 폴더에는 항목이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowAccessDenied, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="이 폴더에 접근할 권한이 없습니다." Foreground="{DynamicResource WarningBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="다른 위치 선택" Margin="0,10,0,0" HorizontalAlignment="Center" Click="OnPickOther" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="폴더를 열 수 없습니다." Foreground="{DynamicResource WarningBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Button Content="다른 위치 선택" Margin="0,10,0,0" HorizontalAlignment="Center" Click="OnPickOther" />
                </StackPanel>

                <!-- 끌어 놓기 안내 -->
                <Border IsHitTestVisible="False" Margin="10" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}" Opacity="0.93"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <TextBlock Text="{Binding DropTitle}" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DropDetail}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding DropCount}" Style="{StaticResource Numeric}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 선택 요약 / 여유 공간 / 이동 후 여유 -->
            <Border x:Name="FooterBorder" Grid.Row="5" Padding="14,8" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="FreeTextBlock" DockPanel.Dock="Right" Text="{Binding FreeText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Numeric}" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProjectionText}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasProjection, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProjectionWarn}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BarFillStrongBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
