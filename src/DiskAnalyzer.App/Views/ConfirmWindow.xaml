<Window x:Class="DiskAnalyzer.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="확인" Width="540" SizeToContent="Height" MaxHeight="680" MinHeight="180"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        KeyDown="OnKeyDown">

    <!-- MessageBox 는 버튼 이름을 바꿀 수 없어서 "계속 이동 / 이동 취소" 같은 문구가 필요한 확인창은 이 창을 쓴다. -->
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TextBrush}" />
        </ScrollViewer>

        <StackPanel x:Name="ButtonRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0" />
    </Grid>
</Window>
