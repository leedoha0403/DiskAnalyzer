<UserControl x:Class="DiskAnalyzer.App.Views.ProcessCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DiskAnalyzer.App.Controls"
             xmlns:km="clr-namespace:DiskAnalyzer.App.Keymaps"
             Background="{DynamicResource WindowBackground}"
             Foreground="{DynamicResource TextBrush}"
             Loaded="OnLoaded" IsVisibleChanged="OnVisibleChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ctl:InverseBoolConverter x:Key="InverseBool" />

        <DataTemplate x:Key="SelectCellTemplate">
            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"
                      HorizontalAlignment="Center"
                      AutomationProperties.AutomationId="{Binding Pid, StringFormat=Select_{0}}" />
        </DataTemplate>

        <!-- 트리 보기: 들여쓰기 + ▸/▾ 접기 토글 + 이름(하위 개수). 평면 보기에서는 토글이 접혀서 예전과 같다. -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                <TextBlock Text="{Binding ToggleGlyph}" Width="14" Cursor="Hand"
                           Visibility="{Binding ToggleVisibility}" Tag="{Binding}"
                           MouseLeftButtonDown="OnToggleClick" Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatusCellTemplate">
            <TextBlock Text="{Binding RespondingText}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="KillCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Content="종료" Padding="10,3" Click="OnKillClick" Tag="{Binding}"
                        IsEnabled="{Binding CanKill}" ToolTip="{Binding KillTooltip}"
                        AutomationProperties.AutomationId="{Binding Pid, StringFormat=Kill_{0}}" />
                <!-- 긴 실패 메시지("관리자 권한으로도...")가 옆 칸을 침범해 겹쳐 보이던 것 - 폭을 고정하고 잘라서
                     전체 문장은 툴팁으로만 보여준다. -->
                <TextBlock Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Width="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ProcessRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DataListItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="프로세스 정리기" Margin="0,0,0,2"
                   ToolTip="죽다 만 프로세스를 강제로 정리합니다. 흐리게 표시된 시스템 프로세스는 안전을 위해 종료할 수 없습니다." />

        <!-- 한 카드에 두 줄만: 위는 검색·보기 옵션, 아래는 선택 작업. 제목/구분선/설명 문구는 없앴다(툴팁으로 대체). -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8,12,2" Margin="0,4,0,8">
            <StackPanel>
                <WrapPanel>
                    <TextBox x:Name="SearchBox" Width="180" Margin="0,0,12,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             km:ShortcutHint.Command="Search.Focus"
                             km:ShortcutHint.Text="이름, PID, 창 제목, 상위 앱(예: claude)으로 검색 - 검색할 때는 전체 프로세스를 대상으로 합니다 {0}"
                             AutomationProperties.AutomationId="ProcessSearch" />
                    <CheckBox Content="트리" IsChecked="{Binding TreeMode}"
                              Margin="0,0,12,6" VerticalAlignment="Center"
                              km:ShortcutHint.Command="Process.ToggleTree"
                              km:ShortcutHint.Text="작업 관리자처럼 부모 앱 아래로 자식 프로세스를 묶어 보여줍니다. 접고 펼 수 있고, 부모를 체크하면 자식도 모두 체크됩니다. {0}"
                              AutomationProperties.AutomationId="TreeMode" />
                    <CheckBox Content="무시 숨김" IsChecked="{Binding HideIgnored}"
                              Margin="0,0,12,6" VerticalAlignment="Center"
                              ToolTip="무시 목록에 올린 프로세스를 목록과 알림에서 뺍니다. 행을 우클릭하면 무시 목록에 추가하거나 해제합니다."
                              AutomationProperties.AutomationId="HideIgnored" />
                    <CheckBox Content="시스템 숨김" IsChecked="{Binding HideProtected}"
                              Margin="0,0,12,6" VerticalAlignment="Center"
                              ToolTip="종료할 수 없는 시스템 보호 프로세스(회색 줄)를 목록에서 뺍니다. 검색하면 그래도 찾을 수 있습니다."
                              AutomationProperties.AutomationId="HideProtected" />
                    <Button Content="무시 목록" Style="{StaticResource LinkButton}" Margin="0,0,12,6"
                            Click="OnIgnoreListClick" AutomationProperties.AutomationId="IgnoreList" />
                    <Button Content="새로고침" Padding="12,3" Margin="0,0,0,6" Command="{Binding RefreshCommand}"
                            km:ShortcutHint.Command="View.Refresh" km:ShortcutHint.Text="새로고침"
                            AutomationProperties.AutomationId="RefreshProcesses" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TabControl HorizontalAlignment="Left" 
                        SelectedIndex="{Binding ViewTab, Mode=TwoWay}"
                        AutomationProperties.AutomationId="ProcessViewTabs">
                <TabItem Header="확인 필요" ToolTip="응답 없음 / 멈춤 의심 프로세스만" AutomationProperties.AutomationId="TabAttention" />
                <TabItem Header="전체 프로세스" AutomationProperties.AutomationId="TabAll" />
                <TabItem Header="{Binding SelectedTabHeader}" ToolTip="체크한 프로세스만 모아 봅니다(검색·필터와 무관, 트리에서는 상위 프로세스도 함께)."
                         AutomationProperties.AutomationId="TabSelected" />
            </TabControl>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="전체 선택" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                        Click="OnSelectAllClick" AutomationProperties.AutomationId="SelectAll"
                        km:ShortcutHint.Command="Selection.SelectAll" km:ShortcutHint.Text="보이는 프로세스를 모두 체크" />
                <Button Content="선택 해제" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                        Click="OnDeselectAllClick" AutomationProperties.AutomationId="DeselectAll"
                        km:ShortcutHint.Command="Search.Cancel" km:ShortcutHint.Text="체크 해제" />
                <Button Content="멈춤 의심 선택" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                        Click="OnSelectSuspiciousClick"
                        km:ShortcutHint.Command="Process.SelectSuspicious"
                        km:ShortcutHint.Text="창 없이 5분 넘게 CPU·디스크 변화가 없는 자식/고아 프로세스를 모두 선택합니다. 종료 전에 목록을 확인하세요. {0}"
                        AutomationProperties.AutomationId="SelectSuspicious" />
                <Button Content="선택 종료" Padding="14,4" 
                        Click="OnKillSelectedClick"
                        km:ShortcutHint.Command="Selection.Delete" km:ShortcutHint.Text="체크한 프로세스를 모두 종료합니다(접혀 있는 하위 프로세스 포함). {0}"
                        AutomationProperties.AutomationId="KillSelected" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListView x:Name="ProcessList" Style="{StaticResource DataList}" ItemsSource="{Binding Rows}"
                          ItemContainerStyle="{StaticResource ProcessRowStyle}"
                          GridViewColumnHeader.Click="OnHeaderClick"
                          ContextMenuOpening="OnListContextMenuOpening"
                          AutomationProperties.AutomationId="ProcessList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="선택" Width="44" CellTemplate="{StaticResource SelectCellTemplate}" />
                            <GridViewColumn Width="70" DisplayMemberBinding="{Binding Pid}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="PID" Tag="Pid" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="200" CellTemplate="{StaticResource NameCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="이름" Tag="Name" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="상위 앱" Width="100" DisplayMemberBinding="{Binding RootApp}" />
                            <GridViewColumn Header="창 제목" Width="130" DisplayMemberBinding="{Binding WindowTitle}" />
                            <GridViewColumn Width="120" CellTemplate="{StaticResource StatusCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="상태" Tag="Responding" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="90" DisplayMemberBinding="{Binding CpuText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Cpu">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CpuTotalText}"
                                                       FontSize="14" HorizontalAlignment="Right" />
                                            <TextBlock Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding MemoryText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Memory">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding MemoryTotalText}"
                                                       FontSize="14" HorizontalAlignment="Right" />
                                            <TextBlock Text="메모리" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding DiskText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Disk">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DiskTotalText}"
                                                       FontSize="14" HorizontalAlignment="Right" />
                                            <TextBlock Text="디스크" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="210" CellTemplate="{StaticResource KillCellTemplate}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="불러오는 중..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- 항상 보이는 하단 합계 줄: 목록에 보이는 것 전체 / 체크한 것 전체. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,6" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="ProcessTotals">
                    <Run Text="{Binding TotalsText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SelectedTotalsText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding Message}" Style="{StaticResource Caption}"
                   AutomationProperties.AutomationId="ProcessCleanerMessage" />

    </Grid>
</UserControl>
