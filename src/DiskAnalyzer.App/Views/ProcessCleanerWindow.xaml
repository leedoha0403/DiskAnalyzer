<Window x:Class="DiskAnalyzer.App.Views.ProcessCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiskAnalyzer.App.Controls"
        Title="프로세스 정리기" Width="820" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="../Fonts/Regular/#Spoqa Han Sans Neo, Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ctl:InverseBoolConverter x:Key="InverseBool" />

        <DataTemplate x:Key="StatusCellTemplate">
            <TextBlock Text="{Binding RespondingText}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Responding}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="KillCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Content="종료" Padding="10,3" Click="OnKillClick" Tag="{Binding}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        AutomationProperties.AutomationId="{Binding Pid, StringFormat=Kill_{0}}" />
                <TextBlock Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ProcessRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DataListItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Responding}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="프로세스 정리기" Style="{StaticResource H1}" />
            <TextBlock Text="게임 등이 죽다 만 채로 창만 사라지고 프로세스가 남아있을 때, 여기서 강제로 정리할 수 있습니다."
                       Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox DockPanel.Dock="Left" Content="전체 프로세스 보기" IsChecked="{Binding ShowAll}"
                      AutomationProperties.AutomationId="ShowAllProcesses" />
            <Button DockPanel.Dock="Right" Content="새로고침" Padding="14,5" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="RefreshProcesses" />
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListView x:Name="ProcessList" Style="{StaticResource DataList}" ItemsSource="{Binding Rows}"
                          ItemContainerStyle="{StaticResource ProcessRowStyle}"
                          AutomationProperties.AutomationId="ProcessList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}" />
                            <GridViewColumn Header="이름" Width="150" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="창 제목" Width="220" DisplayMemberBinding="{Binding WindowTitle}" />
                            <GridViewColumn Header="상태" Width="90" CellTemplate="{StaticResource StatusCellTemplate}" />
                            <GridViewColumn Header="메모리" Width="90" DisplayMemberBinding="{Binding MemoryText}" />
                            <GridViewColumn Header="" Width="170" CellTemplate="{StaticResource KillCellTemplate}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="불러오는 중..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="18"
                   Text="{Binding Message}" Style="{StaticResource Caption}"
                   AutomationProperties.AutomationId="ProcessCleanerMessage" />

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="닫기" Padding="18,7" MinWidth="90" Click="OnCloseClick"
                    AutomationProperties.AutomationId="ProcessCleanerClose" />
        </DockPanel>
    </Grid>
</Window>
