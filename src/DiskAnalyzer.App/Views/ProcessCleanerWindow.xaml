<Window x:Class="DiskAnalyzer.App.Views.ProcessCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiskAnalyzer.App.Controls"
        Title="프로세스 정리기" Width="1120" Height="640" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="../Fonts/Regular/#Spoqa Han Sans Neo, Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ctl:InverseBoolConverter x:Key="InverseBool" />

        <DataTemplate x:Key="SelectCellTemplate">
            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"
                      HorizontalAlignment="Center"
                      AutomationProperties.AutomationId="{Binding Pid, StringFormat=Select_{0}}" />
        </DataTemplate>

        <!-- 트리 보기: 들여쓰기 + ▸/▾ 접기 토글 + 이름(하위 개수). 평면 보기에서는 토글이 접혀서 예전과 같다. -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                <TextBlock Text="{Binding ToggleGlyph}" Width="14" Cursor="Hand"
                           Visibility="{Binding ToggleVisibility}" Tag="{Binding}"
                           MouseLeftButtonDown="OnToggleClick" Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatusCellTemplate">
            <TextBlock Text="{Binding RespondingText}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="KillCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Content="종료" Padding="10,3" Click="OnKillClick" Tag="{Binding}"
                        IsEnabled="{Binding CanKill}" ToolTip="{Binding KillTooltip}"
                        AutomationProperties.AutomationId="{Binding Pid, StringFormat=Kill_{0}}" />
                <!-- 긴 실패 메시지("관리자 권한으로도...")가 옆 칸을 침범해 겹쳐 보이던 것 - 폭을 고정하고 잘라서
                     전체 문장은 툴팁으로만 보여준다. -->
                <TextBlock Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Width="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ProcessRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DataListItem}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="{Binding IgnoreMenuText}" Click="OnIgnoreMenuClick" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="프로세스 정리기" Style="{StaticResource H1}" />
            <TextBlock Text="게임 등이 죽다 만 채로 창만 사라지고 프로세스가 남아있을 때, 여기서 강제로 정리할 수 있습니다. 작업 관리자처럼 CPU·메모리·디스크가 계속 갱신됩니다. 흐리게 표시된 시스템 프로세스는 안전을 위해 종료할 수 없습니다."
                       Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 좁은 창에서 DockPanel 좌/우 도킹 버튼끼리 겹치던 문제 - WrapPanel 은 겹치는 대신 다음 줄로 넘어간다.
             기능별로 "조회/필터" 와 "선택 작업" 두 줄로 나눠서 어떤 버튼이 무슨 그룹인지 한눈에 보이게 했다. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="조회 / 필터" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <WrapPanel>
                    <TextBox x:Name="SearchBox" Width="220" Margin="0,0,14,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="이름, PID, 창 제목, 상위 앱(예: claude)으로 검색 - 검색할 때는 전체 프로세스를 대상으로 합니다"
                             AutomationProperties.AutomationId="ProcessSearch" />
                    <CheckBox Content="트리로 보기" IsChecked="{Binding TreeMode}"
                              Margin="0,0,14,6" VerticalAlignment="Center"
                              ToolTip="작업 관리자처럼 부모 앱 아래로 자식 프로세스를 묶어 보여줍니다. ▸/▾ 로 접고 펼 수 있고, 그룹의 [종료]는 자식까지 함께 끝냅니다."
                              AutomationProperties.AutomationId="TreeMode" />
                    <CheckBox Content="전체 프로세스 보기" IsChecked="{Binding ShowAll}"
                              Margin="0,0,14,6" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="ShowAllProcesses" />
                    <CheckBox Content="선택 항목만 보기" IsChecked="{Binding ShowSelectedOnly}"
                              Margin="0,0,14,6" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="ShowSelectedOnly" />
                    <CheckBox Content="무시한 프로세스 숨기기" IsChecked="{Binding HideIgnored}"
                              Margin="0,0,14,6" VerticalAlignment="Center"
                              ToolTip="무시 목록에 올린 프로세스를 목록과 알림에서 뺍니다. 행을 우클릭하면 무시 목록에 추가하거나 해제합니다."
                              AutomationProperties.AutomationId="HideIgnored" />
                    <Button Content="무시 목록" Style="{StaticResource LinkButton}" Margin="0,0,14,6"
                            Click="OnIgnoreListClick" AutomationProperties.AutomationId="IgnoreList" />
                    <Button Content="새로고침" Padding="14,5" Margin="0,0,0,6" Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="RefreshProcesses" />
                </WrapPanel>

                <Separator Margin="0,10,0,10" />

                <TextBlock Text="선택 작업" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="전체 선택" Style="{StaticResource LinkButton}" Margin="0,0,10,6"
                            Click="OnSelectAllClick" AutomationProperties.AutomationId="SelectAll" />
                    <Button Content="전체 선택 해제" Style="{StaticResource LinkButton}" Margin="0,0,14,6"
                            Click="OnDeselectAllClick" AutomationProperties.AutomationId="DeselectAll" />
                    <Button Content="멈춤 의심 전체 선택" Style="{StaticResource LinkButton}" Margin="0,0,14,6"
                            Click="OnSelectSuspiciousClick"
                            ToolTip="창 없이 5분 넘게 CPU·디스크 변화가 없는 자식/고아 프로세스를 모두 선택합니다. 종료 전에 목록을 확인하세요."
                            AutomationProperties.AutomationId="SelectSuspicious" />
                    <Button Content="선택 종료" Padding="14,5" Margin="0,0,0,6" Click="OnKillSelectedClick"
                            AutomationProperties.AutomationId="KillSelected" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SelectionSummaryText}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="SelectionSummary" />
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListView x:Name="ProcessList" Style="{StaticResource DataList}" ItemsSource="{Binding Rows}"
                          ItemContainerStyle="{StaticResource ProcessRowStyle}"
                          GridViewColumnHeader.Click="OnHeaderClick"
                          AutomationProperties.AutomationId="ProcessList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="선택" Width="44" CellTemplate="{StaticResource SelectCellTemplate}" />
                            <GridViewColumn Width="70" DisplayMemberBinding="{Binding Pid}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="PID" Tag="Pid" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="200" CellTemplate="{StaticResource NameCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="이름" Tag="Name" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="상위 앱" Width="100" DisplayMemberBinding="{Binding RootApp}" />
                            <GridViewColumn Header="창 제목" Width="130" DisplayMemberBinding="{Binding WindowTitle}" />
                            <GridViewColumn Width="120" CellTemplate="{StaticResource StatusCellTemplate}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="상태" Tag="Responding" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="70" DisplayMemberBinding="{Binding CpuText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="CPU" Tag="Cpu" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="85" DisplayMemberBinding="{Binding MemoryText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="메모리" Tag="Memory" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="90" DisplayMemberBinding="{Binding DiskText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="디스크" Tag="Disk" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="210" CellTemplate="{StaticResource KillCellTemplate}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Text="불러오는 중..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Caption}"
                           Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="18"
                   Text="{Binding Message}" Style="{StaticResource Caption}"
                   AutomationProperties.AutomationId="ProcessCleanerMessage" />

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="닫기" Padding="18,7" MinWidth="90" Click="OnCloseClick"
                    AutomationProperties.AutomationId="ProcessCleanerClose" />
        </DockPanel>
    </Grid>
</Window>
