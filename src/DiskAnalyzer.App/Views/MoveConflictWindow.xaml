<Window x:Class="DiskAnalyzer.App.Views.MoveConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이름이 같은 항목이 있습니다" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        KeyDown="OnKeyDown">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="이름이 같은 항목이 있습니다." Style="{StaticResource H1}" />
        <TextBlock x:Name="NameText" Grid.Row="1" Margin="0,8,0,2" FontSize="15" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- 기존 항목 / 이동할 항목 비교 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="기존 항목" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="ExistingSize" Style="{StaticResource Numeric}" FontSize="17"
                               FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock x:Name="ExistingDate" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="ExistingPath" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12"
                    BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel>
                    <TextBlock Text="이동할 항목" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="SourceSize" Style="{StaticResource Numeric}" FontSize="17"
                               FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock x:Name="SourceDate" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="SourcePath" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <CheckBox x:Name="ApplyAll" Content="이후 모든 충돌에 동일한 설정 적용" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OverwriteButton" MinWidth="110" Padding="16,7" Click="OnOverwrite" Margin="0,0,8,0" />
                <Button x:Name="SkipButton" Content="건너뛰기" MinWidth="96" Padding="16,7" Click="OnSkip"
                        Style="{StaticResource AccentButton}" IsDefault="True" Margin="0,0,8,0" />
                <Button Content="새 이름으로 이동" MinWidth="130" Padding="16,7" Click="OnRename" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
