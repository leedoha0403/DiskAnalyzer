<UserControl x:Class="DiskAnalyzer.App.Views.ProcessCleanerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DiskAnalyzer.App.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibleChanged">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ctl:InverseBoolConverter x:Key="InverseBool" />

        <!-- 좁은 사이드바용 한 줄: [선택] 이름(하위 개수) / 상태 · CPU · 메모리 [종료]. 우클릭하면 무시 목록 메뉴. -->
        <DataTemplate x:Key="CompactRow">
            <Border Padding="4,3" CornerRadius="4" Margin="0,0,0,2">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding IgnoreMenuText}" Click="OnIgnoreMenuClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="종료" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Click="OnKillClick" Tag="{Binding}" IsEnabled="{Binding CanKill}" ToolTip="{Binding KillTooltip}" />
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"
                              IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}" />
                    <StackPanel Margin="{Binding IndentMargin}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ToggleGlyph}" Width="12" Cursor="Hand" Visibility="{Binding ToggleVisibility}"
                                       Tag="{Binding}" MouseLeftButtonDown="OnToggleClick"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" FontSize="11">
                            <Run Text="{Binding RespondingText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CpuText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MemoryText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="10,8">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="크게" Style="{StaticResource LinkButton}"
                        Click="OnOpenFullClick" ToolTip="프로세스 정리기 전체 창 열기"
                        AutomationProperties.AutomationId="ProcessPanelOpenFull" />
                <Button x:Name="ExpandButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Click="OnExpandClick" ToolTip="펼치기 / 접기 (접어도 상태바 알림을 위해 느리게 계속 확인합니다)"
                        AutomationProperties.AutomationId="ProcessPanelToggle" />
            </DockPanel>

            <StackPanel x:Name="Body" DockPanel.Dock="Top">
                <TextBox Margin="0,6,0,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="이름, PID, 창 제목, 상위 앱(예: claude)으로 검색 - 검색할 때는 전체 프로세스가 대상입니다"
                         AutomationProperties.AutomationId="ProcessPanelSearch" />
                <WrapPanel Margin="0,0,0,4">
                    <CheckBox Content="트리" IsChecked="{Binding TreeMode}" Margin="0,0,10,2" />
                    <CheckBox Content="전체" IsChecked="{Binding ShowAll}" Margin="0,0,10,2"
                              ToolTip="끄면 응답 없음 / 멈춤 의심 프로세스만 보입니다" />
                    <CheckBox Content="선택만" IsChecked="{Binding ShowSelectedOnly}" Margin="0,0,10,2" />
                    <CheckBox Content="무시 숨김" IsChecked="{Binding HideIgnored}" Margin="0,0,0,2"
                              ToolTip="무시 목록에 올린 프로세스를 목록에서 감춥니다 (행을 우클릭해서 무시 목록에 추가)"
                              AutomationProperties.AutomationId="ProcessPanelHideIgnored" />
                </WrapPanel>

                <ScrollViewer x:Name="ListScroll" Height="170" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="ProcessPanelList">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CompactRow}" />
                </ScrollViewer>

                <!-- 목록 높이 조절 손잡이: 위아래로 끌면 목록이 늘고 줄며, 값은 ui.json 에 남는다. -->
                <Thumb x:Name="ResizeGrip" Height="8" Cursor="SizeNS" Margin="0,2,0,0"
                       DragDelta="OnGripDelta" DragCompleted="OnGripCompleted"
                       ToolTip="끌어서 목록 높이 조절">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Border Height="2" Width="36" CornerRadius="1" Background="{DynamicResource BorderBrushSoft}" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectionSummaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="34"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />

                <WrapPanel Margin="0,6,0,0">
                    <Button Content="의심 선택" Padding="8,3" Margin="0,0,6,4" Click="OnSelectSuspiciousClick"
                            ToolTip="창 없이 5분 넘게 변화가 없는 자식/고아 프로세스를 모두 선택합니다 (무시 목록 제외)"
                            AutomationProperties.AutomationId="ProcessPanelSelectSuspicious" />
                    <Button Content="해제" Padding="8,3" Margin="0,0,6,4" Click="OnDeselectAllClick" />
                    <Button Content="선택 종료" Padding="8,3" Margin="0,0,6,4" Click="OnKillSelectedClick"
                            AutomationProperties.AutomationId="ProcessPanelKillSelected" />
                    <Button Content="무시 목록" Padding="8,3" Margin="0,0,0,4" Click="OnIgnoreListClick"
                            ToolTip="무시한 프로세스 이름을 보고 해제합니다"
                            AutomationProperties.AutomationId="ProcessPanelIgnoreList" />
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
