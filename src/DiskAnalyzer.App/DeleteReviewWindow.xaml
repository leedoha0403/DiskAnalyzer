<Window x:Class="DiskAnalyzer.App.DeleteReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="삭제할 파일 확인" Height="760" Width="1120" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="삭제할 파일 확인" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding VerdictText}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="🔒 보호됨(P0) 항목은 선택할 수 없습니다. ⚠ 고위험(P1) 항목은 기본 해제되어 있습니다." />
        </StackPanel>

        <!-- 11. 정렬 / 검색 / 일괄 선택 -->
        <Grid Grid.Row="1" Margin="0,0,0,10"
              Visibility="{Binding ShowToolbar, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="전체 선택" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                <Button Content="전체 해제" Command="{Binding ClearAllCommand}" Margin="0,0,16,0" />
                <CheckBox Content="실패 항목만 보기" IsChecked="{Binding ShowFailuresOnly}"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsResult, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="정렬" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          Width="120" Margin="0,0,12,0" />
                <Grid Width="240">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="파일명 / 경로 검색" IsHitTestVisible="False" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 목록 (가상화) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="RowList" Style="{StaticResource CardList}" ItemsSource="{Binding Rows}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 9. 확인창에서 개별 제외. P0 는 비활성. -->
                            <CheckBox Grid.RowSpan="2" VerticalAlignment="Center" Margin="2,0,10,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LevelBadge}" FontSize="10.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="P0">
                                                    <Setter Property="Foreground" Value="{DynamicResource BarFillStrongBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="P1">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                                           MinWidth="90" TextAlignment="Right" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding TypeText}" Style="{StaticResource Caption}"
                                           MinWidth="60" TextAlignment="Right" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Caption}" MinWidth="86" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullPath}"
                                       Style="{StaticResource Caption}" Margin="0,3,12,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />

                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,3,0,0">
                                <TextBlock Text="{Binding WarningText}" FontSize="11"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="12,0,0,0"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 13. 진행 상황 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Deleting..." Style="{StaticResource H2}" Margin="0,0,0,8" />
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="6" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Numeric}" FontSize="13" Margin="0,8,0,0" />
                <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 13. 결과 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding IsResult, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="삭제 완료" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Numeric}" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 선택 요약 + 버튼 -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsReview, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource H2}" />
                <TextBlock Text="  ·  예상 확보 공간 " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource Numeric}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="취소" Click="OnCancel" Margin="0,0,8,0" />
                <Button x:Name="RecycleButton" Content="휴지통으로 이동" Style="{StaticResource AccentButton}"
                        Click="OnRecycle" Margin="0,0,8,0"
                        Visibility="{Binding IsReview, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="PermanentButton" Content="영구 삭제..." Style="{StaticResource DangerButton}"
                        Click="OnPermanent"
                        Visibility="{Binding IsReview, Converter={StaticResource BoolToVis}}" />
                <Button x:Name="CloseButton" Content="닫기" Style="{StaticResource AccentButton}" Click="OnClose"
                        Visibility="{Binding IsResult, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
