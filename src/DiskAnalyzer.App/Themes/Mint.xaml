<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AIUsageMonitor(자매 앱, WPF) 의 팔레트를 그대로 옮겨 왔다 - 흰 카드 + 옅은 회록색 캔버스 +
         짙은 잉크 텍스트 + 테엌그린 액센트(#1F8A70). Dark / Light / Daisy 를 건드리지 않고
         네 번째 선택지로 얹는다(모든 스타일이 DynamicResource 라 사전만 갈아 끼우면 된다) -
         지금은 이 팔레트를 기본값으로 쓴다. -->

    <Color x:Key="WindowBackgroundColor">#FFF6F8F7</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF6F8F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFBFCFC" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFEFF3F2" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#2415191D" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#4015191D" />

    <SolidColorBrush x:Key="TextBrush" Color="#FF15191D" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF66717C" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FFA0A8B0" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF1F8A70" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#331F8A70" />
    <SolidColorBrush x:Key="BarFillBrush" Color="#FF1F8A70" />
    <SolidColorBrush x:Key="BarFillStrongBrush" Color="#FFE0574B" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="#FFE7EDEC" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFD9EEE9" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FFC98A1D" />
    <SolidColorBrush x:Key="FolderIconBrush" Color="#FFD4A83A" />
    <SolidColorBrush x:Key="FileIconBrush" Color="#FF6E8CA0" />

    <SolidColorBrush x:Key="TreemapStrokeBrush" Color="#FFFFFFFF" />
    <!-- Treemap 상자 색을 짙게 바꾸면서 흰 글자가 어울리게 됐다(Dark 테마와 같은 값). -->
    <SolidColorBrush x:Key="TreemapLabelBrush" Color="#FFFFFFFF" />

</ResourceDictionary>
