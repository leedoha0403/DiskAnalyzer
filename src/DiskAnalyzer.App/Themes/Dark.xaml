<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 17. UI 디자인 - Windows 11 기반 Dark Mode(기본).
         색상 수를 최소화하고 정보는 숫자 + Bar + 텍스트로 함께 전달한다. -->

    <Color x:Key="WindowBackgroundColor">#FF1C1C1C</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF383838" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF4A4A4A" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9C9C9C" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF6E6E6E" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#332E9BD6" />
    <SolidColorBrush x:Key="BarFillBrush" Color="#FF3A8FD6" />
    <SolidColorBrush x:Key="BarFillStrongBrush" Color="#FFE06C4F" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF2D4A63" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FFE0A03A" />
    <SolidColorBrush x:Key="FolderIconBrush" Color="#FFD9A441" />
    <SolidColorBrush x:Key="FileIconBrush" Color="#FF7FA8C9" />

    <SolidColorBrush x:Key="TreemapStrokeBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="TreemapLabelBrush" Color="#FFFFFFFF" />

</ResourceDictionary>
