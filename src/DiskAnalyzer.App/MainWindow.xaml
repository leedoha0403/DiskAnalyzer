<Window x:Class="DiskAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiskAnalyzer.App.Controls"
        xmlns:views="clr-namespace:DiskAnalyzer.App.Views"
        xmlns:km="clr-namespace:DiskAnalyzer.App.Keymaps"
        Title="Disk Analyzer" Height="880" Width="1440" MinHeight="600" MinWidth="1080"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ctl:TreeRowWidthConverter x:Key="TreeRowWidth" />
        <ctl:DepthIndentConverter x:Key="DepthIndent" />

        <!-- 15. 파일 / 폴더 우클릭 메뉴 -->
        <ContextMenu x:Key="RowMenu" x:Shared="False" Opened="OnRowMenuOpened">
            <MenuItem Header="탐색기에서 열기" Click="OnOpenExplorer" km:ShortcutHint.Command="Selection.Open" />
            <MenuItem Header="경로 복사" Click="OnCopyPath" km:ShortcutHint.Command="Clipboard.CopyPath" />
            <MenuItem Header="파일명 복사" Click="OnCopyName" />
            <MenuItem Header="속성 보기" Click="OnShowProperties" km:ShortcutHint.Command="Selection.ShowDetails" />
            <!-- 49. 검색 결과 / 큰 파일에서 찾은 것을 폴더 탭(과 Treemap)의 그 위치로 데려간다 -->
            <MenuItem Tag="reveal" Header="이 항목이 있는 폴더 열기" Click="OnRevealRow"
                      ToolTip="폴더 탭을 이 항목이 있는 폴더로 옮기고 항목을 선택합니다. Treemap 도 같은 위치로 따라갑니다" />
            <MenuItem Tag="fav" Header="즐겨찾기에 추가" Click="OnRowFavorite" />
            <MenuItem Header="수집함에 담기" Click="OnRowCollect" km:ShortcutHint.Command="Selection.ToggleCollect" />
            <Separator />
            <MenuItem Header="이동 (좌) - 빠른 이동 출발지로 보내기" Click="OnSendLeft"
                      ToolTip="빠른 이동 도크의 출발지(위) 패널에서 이 항목을 선택해 둡니다. 탭을 벗어나지 않습니다" />
            <MenuItem Header="이동 (우) - 빠른 이동 목적지로 열기" Click="OnSendRight"
                      ToolTip="빠른 이동 도크의 목적지(아래) 패널을 이 폴더(파일이면 그 폴더)로 엽니다" />
            <MenuItem Header="이동 대기열에 추가 (현재 목적지로)" Click="OnSendQueue"
                      ToolTip="목적지를 한 번 정해 두면, 이 항목들을 바로 이동 대기열에 담습니다" />
            <Separator />
            <MenuItem Header="휴지통으로 이동" Click="OnRecycle" km:ShortcutHint.Command="Selection.Delete" />
            <MenuItem Header="영구 삭제" Click="OnDeletePermanently" km:ShortcutHint.Command="Selection.DeletePermanent" />
        </ContextMenu>

        <!-- 6. 폴더 테이블 셀 템플릿 -->
        <DataTemplate x:Key="NameCell">
            <!-- 49. 경로별 묶기는 같은 목록 안에서 들여쓰기로 표현한다(Depth 는 묶지 않으면 0 이라 평소와 똑같다). -->
            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}"
                        Margin="{Binding Depth, Converter={StaticResource DepthIndent}}">
                <TextBlock Text="{Binding ChevronText}" Width="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                <Border Width="9" Height="9" CornerRadius="2" Margin="2,0,9,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource FileIconBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource FolderIconBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <!-- 묶음 머리글만 살짝 굵게. 색을 바꾸지 않아 목록의 결이 유지된다. -->
                                <DataTrigger Binding="{Binding IsSearchGroup}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding MatchCountText}" Style="{StaticResource Caption}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                       HorizontalAlignment="Right" Margin="0,0,10,0" />
        </DataTemplate>

        <!-- 3/17. 숫자 + Bar + 텍스트를 함께 보여 준다. 색만으로 정보를 전달하지 않는다. -->
        <DataTemplate x:Key="RatioCell">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <ctl:RatioBar Ratio="{Binding Ratio}" Height="16" VerticalAlignment="Center"
                              Fill="{DynamicResource BarFillBrush}"
                              HighlightFill="{DynamicResource BarFillStrongBrush}"
                              Track="{DynamicResource BarTrackBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding RatioText}" Style="{StaticResource Numeric}"
                           FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryCell">
            <TextBlock Text="{Binding CategoryText}" FontSize="10.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ================= 42. 상태바 ================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusFiles}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusFolders}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusSize}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusElapsed}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusSkipped}" Style="{StaticResource Caption}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusMode}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusCache}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource WarningBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </Grid>
        </Border>

        <!-- ================= 헤더 ================= -->
        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">

            <Grid Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <!-- 저장소 사이드바 토글. 글리프 대신 도형으로 그린다 - 아이콘 글꼴이 없는 환경에서
                         네모(tofu)로 깨지지 않고, 테마 색을 그대로 따라간다. -->
                    <Button x:Name="SidebarToggle" Click="OnToggleSidebar"
                            Margin="0,0,12,0" Padding="8,6" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="SidebarToggle"
                            AutomationProperties.Name="저장소 사이드바 접기 / 펼치기"
                            km:ShortcutHint.Command="View.ToggleSidebar"
                            km:ShortcutHint.Text="저장소 사이드바 접기 / 펼치기 {0}">
                        <Grid Width="17" Height="14">
                            <Border CornerRadius="3" BorderThickness="1.4"
                                    BorderBrush="{DynamicResource TextBrush}" />
                            <Border x:Name="SidebarToggleFill" Width="5" HorizontalAlignment="Left"
                                    Margin="1.4" CornerRadius="1.5,0,0,1.5"
                                    Background="{DynamicResource TextBrush}" />
                        </Grid>
                    </Button>
                    <TextBlock Text="Disk Analyzer" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ElevationHint" Style="{StaticResource Caption}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                    <Button x:Name="ElevateButton" Content="관리자 권한으로 다시 실행"
                            AutomationProperties.AutomationId="ElevateButton"
                            Click="OnRestartAsAdmin" Margin="10,0,0,0" Padding="10,4" FontSize="11.5"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsNotElevated, Converter={StaticResource BoolToVis}}"
                            ToolTip="NTFS Fast Scan 을 쓰려면 관리자 권한이 필요합니다. UAC 승인 후 같은 경로를 다시 스캔합니다." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="선택 드라이브 스캔" Style="{StaticResource AccentButton}"
                            Command="{Binding ScanSelectedCommand}" Margin="0,0,8,0"
                            ToolTip="왼쪽 사이드바에서 고른 드라이브를 스캔합니다&#10;드라이브 카드를 더블 클릭해도 같습니다" />
                    <Button Content="전체 스캔" Command="{Binding ScanAllCommand}" Margin="0,0,8,0"
                            ToolTip="연결된 모든 드라이브를 차례로 스캔합니다" />
                    <Button Content="새로고침" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                            km:ShortcutHint.Command="View.ForceRescan" km:ShortcutHint.Text="현재 위치를 다시 스캔합니다" />
                    <Button Content="스캔 중지" Command="{Binding CancelCommand}" Margin="0,0,16,0"
                            ToolTip="진행 중인 스캔을 멈춥니다&#10;그때까지 읽은 결과는 남습니다" />
                    <ToggleButton x:Name="DockToggle" Content="이동 도크" IsChecked="{Binding QuickMove.IsDockVisible}" Margin="0,0,8,0"
                                  AutomationProperties.AutomationId="DockToggle"
                                  ToolTip="화면 오른쪽에 '빠른 이동' 도크를 붙입니다. 폴더 / Treemap 을 보면서 출발지(위)·목적지(아래)를 함께 볼 수 있습니다" />
                    <ToggleButton Content="설정" IsChecked="{Binding ShowSettings}" Margin="0,0,8,0"
                                  ToolTip="스캔 방식 · 테마 · 제외 규칙 · 내보내기&#10;맨 아래 [단축키 설정...] 에서 모든 단축키를 바꿀 수 있습니다" />
                    <ToggleButton Content="성능" IsChecked="{Binding ShowPerfMonitor}"
                                  ToolTip="스캔 속도 · 워커 수 · 큐 길이 · 메모리를 실시간으로 봅니다" />
                </StackPanel>
            </Grid>

            <!-- 5. 스캔 진행 상태 -->
            <Border Style="{StaticResource Card}" Margin="0,2,0,12" Padding="16,13"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding ProgressPercent}" Style="{StaticResource H2}" DockPanel.Dock="Right" />
                        <TextBlock Style="{StaticResource H2}">
                            <Run Text="Scanning " /><Run Text="{Binding CurrentPath, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="6" Margin="0,0,0,12" />
                    <UniformGrid Columns="5" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Files" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ProgressFiles}" Style="{StaticResource Numeric}" FontSize="15" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Folders" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ProgressFolders}" Style="{StaticResource Numeric}" FontSize="15" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Analyzed" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ProgressAnalyzed}" Style="{StaticResource Numeric}" FontSize="15" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Speed" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ProgressSpeed}" Style="{StaticResource Numeric}" FontSize="15" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Elapsed" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ProgressElapsed}" Style="{StaticResource Numeric}" FontSize="15" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding ProgressCurrent}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= 본문 ================= -->
        <Grid Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="264" MinWidth="190" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="470" />
            </Grid.ColumnDefinitions>

            <!-- 4.1 저장소 사이드바. 드라이브와 고정한 스캔 대상이 세로로 쌓인다.
                 위쪽 가로 띠에 두면 스캔 결과가 보이는 높이를 늘 빼앗아 간다 —
                 왼쪽에 세우고 접을 수 있게 하면 필요할 때만 자리를 쓴다. -->
            <Border x:Name="Sidebar" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="저장소" Style="{StaticResource H2}"
                               Margin="14,11,14,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,0,14,4">
                        <StackPanel>
                        <!-- 4.1 드라이브 요약 -->
                        <ItemsControl x:Name="DriveCards" ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12"
                                            MouseLeftButtonUp="OnDriveCardClick" Cursor="Hand" Tag="{Binding}"
                                            ToolTip="누르면 이 드라이브를 고르고, 더블 클릭하면 바로 스캔합니다">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}"
                                                           DockPanel.Dock="Right" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Numeric}" FontSize="12.5" Margin="0,0,0,7">
                                                <Run Text="{Binding UsedText, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="{DynamicResource TextDimBrush}" />
                                                <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </TextBlock>
                                            <ProgressBar Value="{Binding UsedPercentValue, Mode=OneWay}" Maximum="100" Height="6" />
                                            <DockPanel Margin="0,7,0,0">
                                                <TextBlock Text="{Binding FileSystem}" Style="{StaticResource Caption}"
                                                           DockPanel.Dock="Right" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding UsedPercentText, Mode=OneWay}" /><Run Text=" 사용 · 남은 " /><Run Text="{Binding FreeText, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 즐겨찾기 = 스캔 대상. 드라이브 목록에 그대로 붙어 있어서 자주 보는 폴더를
                             매번 찾아 들어가지 않고 바로 스캔할 수 있다. -->
                        <ItemsControl x:Name="PinnedTargets" ItemsSource="{Binding PinnedTargets}"
                                      AutomationProperties.AutomationId="PinnedTargets">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10"
                                            Cursor="Hand" Tag="{Binding Path}" MouseLeftButtonUp="OnPinnedCardClick"
                                            ToolTip="{Binding Path}">
                                        <DockPanel>
                                            <TextBlock Text="&#x2605;" DockPanel.Dock="Left" Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                            <Button DockPanel.Dock="Right" Content="스캔" Padding="10,2" Margin="8,0,0,0"
                                                    Tag="{Binding Path}" Click="OnPinnedScan"
                                                    ToolTip="이 폴더를 다시 스캔합니다" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="10"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Background="Transparent" DragCompleted="OnSidebarSplitterDragCompleted"
                          ToolTip="끌어서 사이드바 너비를 조절합니다" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>

                    <!-- 8. 주요 탭 + 12/13. 검색 / 필터 -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1" Padding="14,6,14,0">
                        <!-- 탭과 필터가 한 줄에 다 안 들어가면 필터가 아랫줄로 내려간다.
                             칸(Grid)으로 나눠 두었을 때는 폭이 모자라면 마지막 칸이 그냥 잘려서
                             [검색] [지우기] 가 화면에서 사라졌다 - 줄이 늘어나는 편이 낫다. -->
                        <WrapPanel>
                            <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged" HorizontalAlignment="Left">
                                <TabItem Header="폴더" />
                                <TabItem Header="Treemap" />
                                <TabItem Header="선버스트" AutomationProperties.AutomationId="SunburstTab" />
                                <TabItem Header="큰 파일" />
                                <TabItem Header="파일 유형" />
                                <TabItem Header="정리 추천" />
                                <TabItem Header="빠른 이동" AutomationProperties.AutomationId="QuickMoveTab" />
                            </TabControl>

                            <!-- 필터 + 검색. 자연 크기로 두고, 한 줄에 안 들어가면 통째로 아랫줄로 내려간다. -->
                            <StackPanel x:Name="FilterBar" Orientation="Horizontal"
                                        Margin="12,0,0,6" VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="크기" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding MinSizeOptions}" SelectedItem="{Binding SelectedMinSize}"
                                              Width="108" Margin="0,0,8,0" />
                                    <Grid Width="118" Margin="0,0,6,0">
                                        <TextBox x:Name="ExtFilterBox"
                                                 Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="확장자 필터 (예: *.pdb;*.log)" />
                                        <TextBlock Text="*.pdb;*.log" IsHitTestVisible="False" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"
                                                   FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ExtFilterBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Content="적용" Command="{Binding ApplyFilterCommand}" Margin="0,0,14,0"
                                            ToolTip="왼쪽의 크기 · 확장자 조건을 목록에 적용합니다&#10;스캔을 다시 하지는 않습니다" />
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding SearchScopeOptions}"
                                          SelectedItem="{Binding SelectedSearchScope}"
                                          Width="112" Margin="0,0,6,0" VerticalAlignment="Center"
                                          ToolTip="검색 범위 - '현재 폴더 하위'는 지금 보고 있는 폴더 안에서만 찾습니다" />

                                <Grid Width="186" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBox x:Name="SearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnSearchKeyDown"
                                             km:ShortcutHint.Command="Search.Focus"
                                             km:ShortcutHint.Text="파일명 / 폴더명 검색 (Enter) {0}&#10;글자만 입력하면 부분 일치, * 와 ? 를 쓰면 이름 전체 패턴 (예: *.log, log_??.txt)" />
                                    <TextBlock Text="파일명 / 폴더명 검색" IsHitTestVisible="False" Margin="10,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"
                                               FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="검색" Command="{Binding SearchCommand}" Margin="0,0,6,0"
                                            km:ShortcutHint.Command="Search.Focus"
                                            km:ShortcutHint.Text="입력한 이름으로 찾습니다 {0}&#10;검색 상자에서 Enter 를 눌러도 됩니다" />
                                    <Button Content="지우기" Command="{Binding ClearSearchCommand}"
                                            km:ShortcutHint.Command="Search.Cancel"
                                            km:ShortcutHint.Text="검색을 지우고 원래 목록으로 돌아갑니다 {0}" />

                                    <!-- 49. 검색 결과가 같은 이름으로 가득 찰 때 폴더 트리로 묶어 본다. 검색 중에만 뜬다. -->
                                    <CheckBox Content="경로별 묶기" IsChecked="{Binding UseSearchTree}" Margin="14,0,0,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="UseSearchTree"
                                              Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVis}}"
                                              ToolTip="검색 결과를 폴더 트리로 묶고, 같은 이름이 2건 이상이면 한 줄로 접습니다&#x0a;(예: R260827 과 R270100 에 하나씩 있는 Moros.mob → 공통 상위 폴더 아래 한 줄)" />
                                    <TextBlock Text="{Binding SearchFoldSummary}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding HasSearchFoldSummary, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- 폴더 / Treemap 이 함께 쓰는 이동 막대: 뒤로·앞으로·상위·루트 · 경로(빈 곳을 누르면 직접 입력) · 변경 감지 · 이 폴더 새로고침 · 즐겨찾기 -->
                    <Border x:Name="NavBar" DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Content="분할 보기" IsChecked="{Binding IsSplitView}"
                                          AutomationProperties.AutomationId="SplitToggle" Margin="12,0,0,0" Padding="10,3"
                                          ToolTip="폴더 목록과 Treemap 을 나란히 표시합니다 (다시 누르면 원래대로)" />

                            <!-- 즐겨찾기: ▾ 목록 / ☆ 지금 폴더 추가·제거. 빠른 이동 탭과 같은 목록이다. -->
                            <Button DockPanel.Dock="Right" Content="▾" Click="OnFavoritesClick" Padding="6,3" Margin="2,0,0,0"
                                    AutomationProperties.AutomationId="FavoritesMenu" ToolTip="즐겨찾기 목록 (빠른 이동 탭과 같은 목록)" />
                            <Button DockPanel.Dock="Right" Command="{Binding PathBar.ToggleFavoriteCommand}" Padding="8,3" Margin="12,0,0,0"
                                    AutomationProperties.AutomationId="FavoriteToggle"
                                    km:ShortcutHint.Command="Navigation.ToggleFavorite" km:ShortcutHint.Text="지금 폴더를 즐겨찾기에 추가 / 제거">
                                <TextBlock FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="☆" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PathBar.IsCurrentFavorite}" Value="True">
                                                    <Setter Property="Text" Value="★" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- 이 폴더만 실제 상태로 새로고침(드라이브 전체 재스캔이 아니다) -->
                            <Button DockPanel.Dock="Right" Content="⟳ 이 폴더" Command="{Binding RefreshFolderCommand}" Padding="10,3" Margin="12,0,0,0"
                                    AutomationProperties.AutomationId="RefreshFolder" ToolTip="{Binding FolderRefreshToolTip}" />

                            <!-- 열린 폴더가 마지막 스캔 이후 바뀌었을 때만 보인다. 누르거나 F5. -->
                            <Button DockPanel.Dock="Right" Content="{Binding FolderChangeText}" Command="{Binding RefreshFolderCommand}"
                                    Style="{StaticResource LinkButton}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"
                                    Margin="12,0,0,0" AutomationProperties.AutomationId="FolderChangeChip"
                                    ToolTip="이 폴더가 마지막 스캔 이후 바뀌었습니다. 눌러서 이 폴더만 새로고침합니다."
                                    Visibility="{Binding HasFolderChanges, Converter={StaticResource BoolToVis}}" />

                            <Button DockPanel.Dock="Right" Content="✎" Command="{Binding PathBar.BeginEditCommand}" Style="{StaticResource LinkButton}"
                                    Margin="12,0,0,0" Width="28" AutomationProperties.AutomationId="EditPath"
                                    km:ShortcutHint.Command="Navigation.FocusPath" km:ShortcutHint.Text="경로 직접 입력 (빈 곳을 눌러도 됩니다)" />

                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="◀" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}"
                                        km:ShortcutHint.Command="Navigation.GoBack" km:ShortcutHint.Text="뒤로" Width="30" />
                                <Button Content="▶" Command="{Binding ForwardCommand}" Style="{StaticResource LinkButton}"
                                        km:ShortcutHint.Command="Navigation.GoForward" km:ShortcutHint.Text="앞으로" Width="30" />
                                <Button Content="▲" Command="{Binding UpCommand}" Style="{StaticResource LinkButton}"
                                        km:ShortcutHint.Command="Navigation.GoParent" km:ShortcutHint.Text="상위 폴더" Width="30" />
                                <Button Content="루트" Command="{Binding RootCommand}" Style="{StaticResource LinkButton}"
                                        km:ShortcutHint.Command="Navigation.GoRoot" km:ShortcutHint.Text="스캔 루트로 이동"
                                        Margin="0,0,10,0" />
                                <Border Width="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,2,10,2" />
                            </StackPanel>

                            <!-- 경로: 평소에는 조각 버튼(클릭하면 그 폴더로), 빈 곳 클릭 / Ctrl+L / ✎ 로 전체 경로 입력 칸으로 바뀐다. -->
                            <Grid x:Name="PathHost" Background="Transparent" MouseLeftButtonDown="OnPathAreaMouseDown">
                                <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PathBar.IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding Name}" Tag="{Binding Id}"
                                                            Click="OnBreadcrumbClick" Style="{StaticResource LinkButton}" />
                                                    <TextBlock Text="›" Foreground="{DynamicResource TextDimBrush}"
                                                               VerticalAlignment="Center" Margin="2,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBox x:Name="PathEdit" Text="{Binding PathBar.Text, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,3" FontSize="12.5" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="PathEdit"
                                         PreviewKeyDown="OnPathEditKeyDown" LostKeyboardFocus="OnPathEditLostFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PathBar.IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- 입력 중인 경로 아래의 폴더 제안(스캔 결과에서). 키보드 포커스는 입력 칸에 둔 채 ↑↓ / Tab 으로 고른다. -->
                                <Popup PlacementTarget="{Binding ElementName=PathHost}" Placement="Bottom"
                                       IsOpen="{Binding PathBar.HasSuggestions, Mode=OneWay}" StaysOpen="True"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushStrong}"
                                            BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,3,0,0"
                                            MinWidth="{Binding ActualWidth, ElementName=PathHost}">
                                        <StackPanel>
                                            <ListBox ItemsSource="{Binding PathBar.Suggestions}" SelectedIndex="{Binding PathBar.SuggestionIndex, Mode=OneWay}"
                                                     Background="Transparent" BorderThickness="0" Focusable="False" MaxHeight="264"
                                                     PreviewMouseLeftButtonUp="OnPathSuggestionClick"
                                                     AutomationProperties.AutomationId="PathBarSuggestions">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" CornerRadius="4" Padding="9,5" Background="Transparent">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="9" Height="9" CornerRadius="2" Margin="0,0,9,0" VerticalAlignment="Center"
                                                                    Background="{DynamicResource FolderIconBrush}" />
                                                            <TextBlock Text="{Binding}" FontSize="12.5" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="Tab 자동완성 · ↑↓ 고르기 · Enter 이동 · Esc 취소" Style="{StaticResource Caption}"
                                                       Margin="9,4,9,2" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- 경로 입력 결과 안내(없는 경로 / 스캔 범위 밖). 범위 밖이면 "이 경로 스캔" 을 바로 제안한다. -->
                    <Border x:Name="PathNotice" DockPanel.Dock="Top" Padding="12,6" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PathBar.HasNotice}" Value="True" />
                                            <Condition Binding="{Binding Visibility, ElementName=NavBar}" Value="Visible" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding PathBar.DismissNoticeCommand}"
                                    Style="{StaticResource LinkButton}" Margin="8,0,0,0" ToolTip="닫기" />
                            <Button DockPanel.Dock="Right" Content="빠른 이동에서 열기" Command="{Binding PathBar.OpenOfferedInQuickMoveCommand}"
                                    Margin="8,0,0,0" Padding="10,3" AutomationProperties.AutomationId="OfferOpenInQuickMove"
                                    Visibility="{Binding PathBar.HasOffer, Converter={StaticResource BoolToVis}}" />
                            <Button DockPanel.Dock="Right" Content="{Binding PathBar.OfferText}" Command="{Binding PathBar.ScanOfferedCommand}"
                                    Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="10,3"
                                    AutomationProperties.AutomationId="OfferScan"
                                    Visibility="{Binding PathBar.HasOffer, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding PathBar.Notice}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PathBar.NoticeIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- 작업 영역: 분석 탭들(TabHost) 오른쪽에 빠른 이동 도크를 붙일 수 있다. -->

                    <!-- ========== 수집함. 탭과 무관하게 항상 아래에 붙어 있다 ==========
                         고르는 행위와 지우는 행위를 분리한다. 담아 두는 동안은 아무 일도 일어나지 않는다. -->
                    <Border x:Name="CollectorBar" DockPanel.Dock="Bottom" Padding="14,7"
                            AllowDrop="True" DragOver="OnCollectorDragOver" Drop="OnCollectorDrop"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="삭제..." Style="{StaticResource DangerPillButton}"
                                    AutomationProperties.AutomationId="CollectorDelete"
                                    Click="OnCollectorDelete" Margin="8,0,0,0" Padding="14,3"
                                    IsEnabled="{Binding HasCollected}"
                                    km:ShortcutHint.Command="Selection.Delete"
                                    km:ShortcutHint.Text="담긴 항목을 삭제 대상 확인 창으로 넘깁니다 {0}&#10;여기서도 즉시 지우지 않습니다" />
                            <Button DockPanel.Dock="Right" Content="비우기" Click="OnCollectorClear"
                                    Margin="8,0,0,0" Padding="12,3" IsEnabled="{Binding HasCollected}"
                                    km:ShortcutHint.Command="Collector.Clear"
                                    km:ShortcutHint.Text="담긴 것을 모두 뺍니다(파일은 그대로입니다) {0}" />
                            <Button DockPanel.Dock="Right" Content="대기열로" Click="OnCollectorToQueue"
                                    AutomationProperties.AutomationId="CollectorToQueue"
                                    Margin="8,0,0,0" Padding="12,3" IsEnabled="{Binding HasCollected}"
                                    km:ShortcutHint.Command="Collector.ToQueue"
                                    km:ShortcutHint.Text="담긴 것을 지우는 대신 빠른 이동 대기열로 보냅니다 {0}&#10;보낸 뒤 수집함은 비워집니다" />
                            <ToggleButton DockPanel.Dock="Right" x:Name="CollectorExpand" Content="목록"
                                          Margin="8,0,0,0" Padding="12,3" IsEnabled="{Binding HasCollected}"
                                          Checked="OnCollectorExpandChanged" Unchecked="OnCollectorExpandChanged"
                                          ToolTip="담긴 것을 펼쳐 확인하고 개별로 뺍니다" />
                            <TextBlock Text="{Binding CollectorText}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <Border x:Name="CollectorPanel" DockPanel.Dock="Bottom" MaxHeight="190"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                        <ListBox x:Name="CollectorList" Style="{StaticResource PlainList}" Padding="8,6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding BadgeText}" Style="{StaticResource Caption}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="34" />
                                        <TextBlock Grid.Column="1" Text="{Binding FullPath}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding FullPath}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   Style="{StaticResource Numeric}" Margin="12,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="&#x2715;" Padding="7,0"
                                                Click="OnCollectorRemove" Tag="{Binding FullPath}"
                                                ToolTip="수집함에서 빼기" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid x:Name="WorkArea">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition x:Name="DockSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="DockColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="TabHost" Grid.Column="0">

                        <!-- ========== 폴더 + Treemap (분할 보기 토글 시 나란히) ========== -->
                        <Grid x:Name="SplitHost">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FolderColumn" Width="*" />
                                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                                <ColumnDefinition x:Name="TreemapColumn" Width="0" />
                            </Grid.ColumnDefinitions>

                            <!-- ========== 폴더 탭 ========== -->
                            <DockPanel x:Name="FolderPanel" Grid.Column="0">
                                <!-- 폴더 탭 다중 선택 + 삭제 (큰 파일 탭과 동일한 UX) -->
                                <Border DockPanel.Dock="Bottom" Padding="12,9" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="FolderSelectionText" Style="{StaticResource H2}"
                                                       Text="0개 항목 선택됨" />
                                            <TextBlock Text="  ·  총 용량 " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FolderSelectionSize" Style="{StaticResource Numeric}"
                                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="0 B" />
                                            <TextBlock x:Name="FolderSelectionHint" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                                       Text="Ctrl+클릭 개별 선택 · Shift+클릭 범위 선택 · Ctrl+A 전체 선택 · 폴더는 하위 전체가 삭제됩니다" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="선택 해제" Click="OnClearFolderSelection" Margin="0,0,8,0" />
                                            <Button Content="삭제..." AutomationProperties.AutomationId="FolderDelete"
                                                    km:ShortcutHint.Command="Selection.Delete"
                                                    km:ShortcutHint.Text="고른 항목을 삭제 확인 창으로 넘깁니다 {0}"
                                                    Style="{StaticResource AccentButton}"
                                                    Click="OnDeleteSelectedFolderItems" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                <ListView x:Name="FolderList" AutomationProperties.AutomationId="FolderList"
                                          Style="{StaticResource DataList}"
                                          PreviewMouseLeftButtonDown="OnFolderListPreviewClick"
                                          ItemsSource="{Binding Rows}"
                                          SelectedItem="{Binding SelectedRow}"
                                          SelectionMode="Extended"
                                          SelectionChanged="OnFolderSelectionChanged"
                                          ContextMenu="{StaticResource RowMenu}"
                                          MouseDoubleClick="OnRowDoubleClick"
                                          GridViewColumnHeader.Click="OnHeaderClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="300" CellTemplate="{StaticResource NameCell}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="이름" Tag="Name" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="110" CellTemplate="{StaticResource SizeCell}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="크기" Tag="Size" HorizontalContentAlignment="Right" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="180" CellTemplate="{StaticResource RatioCell}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="점유율" Tag="Size" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="90" DisplayMemberBinding="{Binding FileCountText}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="파일" Tag="FileCount" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="80" DisplayMemberBinding="{Binding DirCountText}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="폴더" Tag="DirectoryCount" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="130" DisplayMemberBinding="{Binding ModifiedText}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="최근 수정일" Tag="Modified" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="170" CellTemplate="{StaticResource CategoryCell}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="카테고리" Tag="Category" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                            <GridViewColumn Width="520" DisplayMemberBinding="{Binding FullPath}">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="전체 경로" Tag="FullPath" />
                                                </GridViewColumn.Header>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                </Grid>
                            </DockPanel>


                            <GridSplitter x:Name="SplitSplitter" Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                          Background="{DynamicResource BorderBrushSoft}" Visibility="Collapsed"
                                          ToolTip="드래그해서 폴더 목록과 Treemap 의 너비를 조절합니다" />

                            <!-- ========== 14. Treemap 탭 ========== -->
                            <DockPanel x:Name="TreemapPanel" Grid.Column="2" Visibility="Collapsed">
                                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" Padding="12,7"
                                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                    <TextBlock x:Name="TreemapInfo" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="사각형 위에 마우스를 올리면 정보가 표시됩니다. 더블 클릭하면 그 폴더로 들어가고, 위쪽 ▲ / 루트 버튼으로 돌아옵니다." />
                                </Border>
                                <ctl:TreemapControl x:Name="Treemap"
                                                    StrokeBrush="{DynamicResource TreemapStrokeBrush}"
                                                    LabelBrush="{DynamicResource TreemapLabelBrush}"
                                                    SelectionBrush="{DynamicResource AccentBrush}">
                                    <ctl:TreemapControl.ContextMenu>
                                        <ContextMenu Opened="OnTreemapMenuOpened">
                                            <MenuItem x:Name="TmOpenExplorer" Header="탐색기에서 열기" Click="OnTreemapOpenExplorer" />
                                            <MenuItem x:Name="TmCopyPath" Header="경로 복사" Click="OnTreemapCopyPath" km:ShortcutHint.Command="Clipboard.CopyPath" />
                                            <MenuItem x:Name="TmFavorite" Header="즐겨찾기에 추가" Click="OnTreemapFavorite" />
                                            <Separator x:Name="TmSeparator" />
                                            <MenuItem x:Name="TmSendLeft" Header="이동 (좌) - 빠른 이동 출발지로 보내기" Click="OnTreemapSendLeft" />
                                            <MenuItem x:Name="TmSendRight" Header="이동 (우) - 빠른 이동 목적지로 열기" Click="OnTreemapSendRight" />
                                            <MenuItem x:Name="TmSendQueue" Header="이동 대기열에 추가 (현재 목적지로)" Click="OnTreemapSendQueue" />
                                        </ContextMenu>
                                    </ctl:TreemapControl.ContextMenu>
                                </ctl:TreemapControl>
                            </DockPanel>

                        </Grid>


                        <!-- ========== 선버스트 탭 ==========
                             가리키면 읽고, 누르면 들어가고, 가운데를 누르면 나온다.
                             조각에 이름을 쓰지 않는다 - 이름은 옆 목록이 맡고 그림은 비율만 말한다. -->
                        <DockPanel x:Name="SunburstPanel" Visibility="Collapsed">

                            <Border DockPanel.Dock="Right" Width="322" Padding="18,14"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0">
                                <DockPanel>
                                    <!-- 현재 폴더 한 줄. 원본처럼 이름과 총량만 크게 둔다. -->
                                    <Grid DockPanel.Dock="Top">
                                        <TextBlock Text="{Binding SunburstTitle}" Style="{StaticResource H2}"
                                                   FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,0,96,0"
                                                   ToolTip="{Binding SunburstTitle}" />
                                        <TextBlock Text="{Binding SunburstTotal}" Style="{StaticResource Numeric}"
                                                   FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="가리키는 중 - 현재 위치는 그대로입니다"
                                               Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding SunburstPeeking, Converter={StaticResource BoolToVis}}" />
                                    <Border DockPanel.Dock="Top" Height="1" Margin="0,8"
                                            Background="{DynamicResource BorderBrushSoft}" />



                                    <ListBox x:Name="SunburstList" ItemsSource="{Binding SunburstSidebar}"
                                             AutomationProperties.AutomationId="SunburstSidebar"
                                             Style="{StaticResource PlainList}"
                                             MouseDoubleClick="OnSunburstSidebarActivate">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1" ToolTip="{Binding Tooltip}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="10" Height="10" Margin="0,0,11,0"
                                                             VerticalAlignment="Center" Fill="{Binding Dot}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14.5"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                               Style="{StaticResource Numeric}" FontSize="13.5"
                                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListItem}">
                                                <Setter Property="Padding" Value="4,4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDim}" Value="True">
                                                        <Setter Property="Opacity" Value="0.58" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Padding="12,6"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <!-- 색 기준은 옆 목록이 아니라 여기 둔다. 목록은 원본처럼
                                         "이름 + 총량 + 항목" 만 남기는 편이 훨씬 조용하다. -->
                                    <TextBlock DockPanel.Dock="Left" Text="색" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <ComboBox DockPanel.Dock="Left" Width="132" Margin="0,0,14,0"
                                              ItemsSource="{Binding RingTintOptions}"
                                              SelectedItem="{Binding SelectedRingTint}"
                                              AutomationProperties.AutomationId="RingTint"
                                              km:ShortcutHint.Command="View.CycleRingTint"
                                              km:ShortcutHint.Text="링의 색 기준 {0}&#10;크기 = 무엇이 큰가 · 정리 추천 = 지워도 되는가 · 증감 = 지난 스캔보다 늘었는가" />
                                    <TextBlock x:Name="SunburstInfo" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>

                            <!-- 가운데 구멍과 이음선은 링이 놓인 패널과 같은 색이어야 한다.
                                 창 배경(더 어두움)을 쓰면 구멍이 검은 원처럼 도드라진다. -->
                            <ctl:SunburstControl x:Name="Sunburst"
                                                 BackdropBrush="{DynamicResource SurfaceBrush}"
                                                 LabelBrush="{DynamicResource TextBrush}"
                                                 MutedBrush="{DynamicResource TextMutedBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 CollectedBrush="{DynamicResource BarFillStrongBrush}">
                                <ctl:SunburstControl.ContextMenu>
                                    <ContextMenu Opened="OnSunburstMenuOpened">
                                        <MenuItem x:Name="SbCollect" Header="수집함에 담기" Click="OnSunburstCollect" km:ShortcutHint.Command="Selection.ToggleCollect" />
                                        <MenuItem x:Name="SbOpenExplorer" Header="탐색기에서 열기" Click="OnSunburstOpenExplorer" />
                                        <MenuItem x:Name="SbCopyPath" Header="경로 복사" Click="OnSunburstCopyPath" km:ShortcutHint.Command="Clipboard.CopyPath" />
                                        <Separator />
                                        <MenuItem x:Name="SbFavorite" Header="즐겨찾기에 추가" Click="OnSunburstFavorite" />
                                    </ContextMenu>
                                </ctl:SunburstControl.ContextMenu>
                            </ctl:SunburstControl>
                        </DockPanel>

                        <!-- ========== 9. 큰 파일 탭 ========== -->
                        <DockPanel x:Name="LargeFilesPanel" Visibility="Collapsed">
                            <!-- 15. 새로고침 버튼을 탭 상단 우측에 고정 배치 -->
                            <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="표시 개수" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding TopNOptions}" SelectedItem="{Binding SelectedTopN}" Width="90" />
                                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                                                   Text="전체 정렬 없이 크기 K 최소 힙으로 상시 유지 - O(N log K)" />
                                    </StackPanel>
                                    <Button Content="{Binding RefreshLargeFilesText}" HorizontalAlignment="Right"
                                            Command="{Binding RefreshLargeFilesCommand}"
                                            ToolTip="현재 목록을 실제 파일 상태와 대조한 뒤 분석 범위를 다시 스캔합니다" />
                                </Grid>
                            </Border>

                            <!-- 6. 선택 상태 + 다중 삭제 -->
                            <Border DockPanel.Dock="Bottom" Padding="12,9" Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="LargeFileSelectionText" Style="{StaticResource H2}"
                                                   Text="0개 파일 선택됨" />
                                        <TextBlock Text="  ·  총 용량 " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LargeFileSelectionSize" Style="{StaticResource Numeric}"
                                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="0 B" />
                                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Text="Ctrl+클릭 개별 선택 · Shift+클릭 범위 선택 · Ctrl+A 전체 선택" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="선택 해제" Click="OnClearLargeFileSelection" Margin="0,0,8,0" />
                                        <Button Content="삭제..." AutomationProperties.AutomationId="LargeFileDelete"
                                                km:ShortcutHint.Command="Selection.Delete"
                                                km:ShortcutHint.Text="고른 항목을 삭제 확인 창으로 넘깁니다 {0}"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnDeleteSelectedLargeFiles" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListView x:Name="LargeFileList" AutomationProperties.AutomationId="LargeFileList" Style="{StaticResource DataList}"
                                      ItemsSource="{Binding TopFiles}"
                                      SelectionMode="Extended"
                                      SelectionChanged="OnLargeFileSelectionChanged"
                                      ContextMenu="{StaticResource RowMenu}"
                                      MouseDoubleClick="OnRowDoubleClick"
                                      GridViewColumnHeader.Click="OnHeaderClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="320" CellTemplate="{StaticResource NameCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="파일명" Tag="Name" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110" CellTemplate="{StaticResource SizeCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="크기" Tag="Size" HorizontalContentAlignment="Right" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="150" CellTemplate="{StaticResource RatioCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="전체 대비" Tag="Size" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding Extension}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="확장자" Tag="Extension" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130" DisplayMemberBinding="{Binding ModifiedText}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="최근 수정일" Tag="Modified" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="160" CellTemplate="{StaticResource CategoryCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="카테고리" Tag="Category" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="620" DisplayMemberBinding="{Binding FullPath}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="경로" Tag="FullPath" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>

                        <!-- ========== 10. 파일 유형 탭 ========== -->
                        <Grid x:Name="FileTypesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>

                            <ListView x:Name="ExtensionList" Style="{StaticResource DataList}"
                                      ItemsSource="{Binding Extensions}"
                                      SelectedItem="{Binding SelectedExtension}"
                                      GridViewColumnHeader.Click="OnHeaderClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="140" DisplayMemberBinding="{Binding Extension}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="확장자" Tag="Extension" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="120" CellTemplate="{StaticResource SizeCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="총 용량" Tag="Size" HorizontalContentAlignment="Right" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="240" CellTemplate="{StaticResource RatioCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="전체 대비 비율" Tag="Size" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="120" DisplayMemberBinding="{Binding CountText}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="파일 개수" Tag="Count" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="240" CellTemplate="{StaticResource CategoryCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="카테고리" Tag="Category" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" Padding="12,6"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,1">
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="확장자를 선택하면 해당 파일 목록이 아래에 표시됩니다 (최대 2,000개, 필요할 때만 조회)" />
                            </Border>

                            <ListView Grid.Row="2" x:Name="ExtensionFileList" Style="{StaticResource DataList}"
                                      ItemsSource="{Binding ExtensionFiles}"
                                      ContextMenu="{StaticResource RowMenu}"
                                      MouseDoubleClick="OnRowDoubleClick"
                                      GridViewColumnHeader.Click="OnHeaderClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="320" CellTemplate="{StaticResource NameCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="파일명" Tag="Name" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110" CellTemplate="{StaticResource SizeCell}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="크기" Tag="Size" HorizontalContentAlignment="Right" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="130" DisplayMemberBinding="{Binding ModifiedText}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="최근 수정일" Tag="Modified" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="700" DisplayMemberBinding="{Binding FullPath}">
                                            <GridViewColumn.Header>
                                                <GridViewColumnHeader Content="경로" Tag="FullPath" />
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- ========== 53~66. 정리 추천 탭 ========== -->
                        <!-- ========== 빠른 이동 탭 ========== -->
                        <views:QuickMoveView x:Name="QuickMovePanel" Visibility="Collapsed" DataContext="{Binding QuickMove}" />

                        <Grid x:Name="CleanupPanel" Visibility="Collapsed" DataContext="{Binding Cleanup}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 3/15. 보기 방식 + 새로고침 -->
                            <Border Background="{DynamicResource SurfaceAltBrush}" Padding="12,8"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="보기" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding ViewModeOptions}" SelectedItem="{Binding SelectedViewMode}"
                                                  Width="130" Margin="0,0,10,0" />
                                        <CheckBox Content="경로 계층 트리" IsChecked="{Binding UseTreeView}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Visibility="{Binding ShowPathModeOptions, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ShowFoldTree, Converter={StaticResource BoolToVis}}">
                                            <Button Content="모두 펼치기" Command="{Binding ExpandAllCommand}" Margin="0,0,6,0" />
                                            <Button Content="모두 접기" Command="{Binding CollapseAllCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="{Binding RefreshText}" HorizontalAlignment="Right"
                                            Command="{Binding RefreshCommand}"
                                            ToolTip="후보를 실제 파일 상태와 대조한 뒤 다시 분석합니다" />
                                </Grid>
                            </Border>

                            <!-- 55/65. 기준 선택 -->
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" Padding="12,8"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="오래된 기준" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedAge}"
                                              Width="110" Margin="0,0,14,0" />
                                    <TextBlock Text="최소 크기" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SelectedSize}"
                                              Width="120" Margin="0,0,14,0" />
                                    <TextBlock Text="카테고리" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                                              Width="170" Margin="0,0,14,0" />
                                    <TextBlock Text="정렬" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                              Width="180" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>

                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="12,6"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}" Style="{StaticResource H2}" />
                                            <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ProtectedInfo}" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding FoldSummary}" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <!-- 파일별 -->
                                        <ListView x:Name="CleanupList" Style="{StaticResource CardList}"
                                                  ItemsSource="{Binding Candidates}"
                                                  MouseDoubleClick="OnCleanupRowDoubleClick"
                                                  Visibility="{Binding ShowFileList, Converter={StaticResource BoolToVis}}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <CheckBox Grid.RowSpan="2" VerticalAlignment="Center" Margin="2,0,10,0"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanSelect}" />

                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   ToolTip="{Binding FullPath}" />

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                                                                       FontSize="13" MinWidth="86" TextAlignment="Right" Margin="0,0,14,0" />
                                                            <TextBlock Text="{Binding TierText}" FontSize="11" MinWidth="104"
                                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding LevelText}" FontSize="11" MinWidth="86"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Level}" Value="P1">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="P0">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BarFillStrongBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Reason}"
                                                                   Style="{StaticResource Caption}" Margin="0,3,12,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />

                                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}"
                                                                   Margin="0,3,0,0" TextAlignment="Right">
                                                            <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text="  ·  수정 " /><Run Text="{Binding ModifiedText, Mode=OneWay}" /><Run Text="  ·  접근 " /><Run Text="{Binding AccessedText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ScoreText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!-- 3-1/5. 경로별 · 유형별 · 정리 이유별 그룹 -->
                                        <ListView x:Name="CleanupGroupList" Style="{StaticResource CardList}"
                                                  ItemsSource="{Binding Groups}"
                                                  Visibility="{Binding ShowGroupList, Converter={StaticResource BoolToVis}}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox VerticalAlignment="Center" Margin="2,0,8,0" IsThreeState="True"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      ToolTip="그룹 전체 선택 / 해제" />
                                                            <ToggleButton Grid.Column="1" Content="▼" Width="26" Padding="0"
                                                                          Margin="0,0,10,0" FontSize="10"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}" />

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Subtitle, Mode=OneWay}" /><Run Text="  ·  가장 오래됨 " /><Run Text="{Binding OldestText, Mode=OneWay}" /><Run Text="  ·  최근 수정 " /><Run Text="{Binding NewestText, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                                                                           FontSize="15" TextAlignment="Right" />
                                                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Right" Margin="0,2,0,0">
                                                                    <Run Text="{Binding FileCountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding GradeText, Mode=OneWay}" /><Run Text="  ·  위험도 " /><Run Text="{Binding RiskText, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 5. 그룹 안에서 개별 파일을 다시 제외할 수 있다 -->
                                                        <ItemsControl ItemsSource="{Binding Items}" Margin="36,8,0,2"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  IsEnabled="{Binding CanSelect}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"
                                                                                   VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                                                                                       FontSize="12" MinWidth="80" TextAlignment="Right" Margin="0,0,12,0" />
                                                                            <TextBlock Text="{Binding LevelText}" Style="{StaticResource Caption}"
                                                                                       MinWidth="80" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!-- 4. 경로 계층 트리 -->
                                        <TreeView x:Name="CleanupTree" ItemsSource="{Binding PathTree}" Padding="8"
                                                  Visibility="{Binding ShowTree, Converter={StaticResource BoolToVis}}">
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid MinWidth="720">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Margin="0,0,8,0" VerticalAlignment="Center" IsThreeState="True"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  ToolTip="이 경로 아래 정리 후보 전체 선택 / 해제" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                                   ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                                                                       FontSize="12.5" MinWidth="90" TextAlignment="Right" Margin="0,0,14,0" />
                                                            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Caption}"
                                                                       MinWidth="110" />
                                                            <TextBlock Text="{Binding GradeText}" Style="{StaticResource Caption}"
                                                                       MinWidth="110" />
                                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}"
                                                                       MinWidth="130" />
                                                        </StackPanel>
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>

                                        <!-- 폴더 트리 + 반복 패턴 접기 -->
                                        <TreeView x:Name="CleanupFoldTreeView" ItemsSource="{Binding FoldTree}" Padding="8"
                                                  AutomationProperties.AutomationId="CleanupFoldTree"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  MouseDoubleClick="OnCleanupFoldDoubleClick"
                                                  Visibility="{Binding ShowFoldTree, Converter={StaticResource BoolToVis}}">
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                    <Grid Margin="0,1" ToolTip="{Binding FullPath}">
                                                        <Grid.Width>
                                                            <MultiBinding Converter="{StaticResource TreeRowWidth}">
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                                                <Binding Path="Depth" />
                                                            </MultiBinding>
                                                        </Grid.Width>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" MaxWidth="460" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Focusable=False: 체크박스가 포커스를 가져가면 중첩 TreeViewItem 의 GotFocus 가
                                                             위로 번져 엉뚱한 상위 행(루트)이 선택 표시된다. -->
                                                        <CheckBox Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanSelect}" />

                                                        <Border Grid.Column="1" Width="9" Height="9" CornerRadius="2"
                                                                Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource FileIconBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource FolderIconBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsDirectoryItem}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource FolderIconBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPattern}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsItem}" Value="False">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPattern}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                   Margin="10,0,12,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Numeric}"
                                                                       FontSize="12.5" MinWidth="90" TextAlignment="Right" Margin="0,0,14,0" />
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                                       MinWidth="190" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding GradeText}" Style="{StaticResource Caption}"
                                                                       MinWidth="110" />
                                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}"
                                                                       MinWidth="130" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Grid>
                                </DockPanel>

                                <!-- 63. 개발자 정리 분석 -->
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1,0,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="개발자 정리 분석" Style="{StaticResource H2}" />
                                            <TextBlock Text="{Binding DeveloperSummary}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,4,0,12" />

                                            <TextBlock Text="Visual Studio 빌드 산출물" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding ProjectsEmptyText}" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProjectsEmptyText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Projects}" MaxHeight="230">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="5"
                                                                Padding="9,6" Margin="0,0,0,5" ToolTip="{Binding ProjectPath}">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right"
                                                                               Style="{StaticResource Numeric}" FontSize="12" />
                                                                    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"
                                                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,2,0,0">
                                                                    <Run Text="{Binding Folders, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastModifiedText, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Git Repository (크기 정보만 제공)" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,12,0,4" />
                                            <TextBlock Text="{Binding GitEmptyText}" Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GitEmptyText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding GitRepos}" MaxHeight="160">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4" ToolTip="{Binding RepoPath}">
                                                            <TextBlock Text="{Binding GitSizeText}" DockPanel.Dock="Right"
                                                                       Style="{StaticResource Numeric}" FontSize="11.5" />
                                                            <TextBlock Text="{Binding RepoName}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="로그 파일 연령 분포" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,12,0,4" />
                                            <ItemsControl ItemsSource="{Binding LogBuckets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right"
                                                                       Style="{StaticResource Numeric}" FontSize="11.5" />
                                                            <TextBlock Style="{StaticResource Caption}">
                                                                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="개" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="분류별 합계" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,12,0,4" />
                                            <ItemsControl ItemsSource="{Binding Summaries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right"
                                                                       Style="{StaticResource Numeric}" FontSize="11.5" />
                                                            <TextBlock Style="{StaticResource Caption}">
                                                                <Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="개" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- 59/60/64. 선택 요약 + 안전 삭제 -->
                            <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" Padding="14,10"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource H2}" />
                                            <TextBlock Text="  ·  예상 확보 용량 " Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ExpectedFreeSpaceText}" Style="{StaticResource Numeric}"
                                                       FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="추천 항목 선택" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0" />
                                            <Button Content="선택 해제" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                                            <Button Content="정리 시뮬레이션" Command="{Binding SimulateCommand}" Margin="0,0,16,0" />
                                            <Button Content="삭제..." Style="{StaticResource AccentButton}"
                                                    Click="OnCleanupDelete" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Simulation}"
                                               FontFamily="Consolas, Cascadia Mono, Malgun Gothic"
                                               Margin="0,8,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Simulation}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <GridSplitter x:Name="DockSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                  Background="{DynamicResource BorderBrushSoft}" Visibility="Collapsed"
                                  DragCompleted="OnDockSplitterDragCompleted"
                                  ToolTip="끌어서 도크 너비를 조절합니다" />

                    <!-- 빠른 이동 도크. 화면은 탭과 같은 인스턴스를 옮겨 쓴다(MainWindow.PlaceQuickMove). -->
                    <Border x:Name="DockHost" Grid.Column="2" Visibility="Collapsed"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ========== 47. 설정 패널 ========== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Width="330" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0" Background="{DynamicResource SurfaceBrush}"
                    Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="설정" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <TextBlock Text="Scan Mode" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding ScanModeOptions}" SelectedItem="{Binding SelectedScanMode}"
                              Margin="0,3,0,10" />

                    <TextBlock Text="Worker Count" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding SelectedWorker}"
                              Margin="0,3,0,10" />

                    <TextBlock Text="UI Theme" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                              Margin="0,3,0,10" />

                    <TextBlock Text="Size Unit" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding SizeUnitOptions}" SelectedItem="{Binding SelectedSizeUnit}"
                              Margin="0,3,0,12" />

                    <CheckBox Content="Symbolic Link / Junction 따라가기" IsChecked="{Binding FollowLinks}" />
                    <CheckBox Content="숨김 파일 표시" IsChecked="{Binding ShowHiddenFiles}" />
                    <CheckBox Content="시스템 파일 표시" IsChecked="{Binding ShowSystemFiles}" />
                    <CheckBox Content="스캔 결과 캐시" IsChecked="{Binding CacheResults}" />

                    <Separator Margin="0,12" />

                    <!-- 48. 스캔 제외 규칙 -->
                    <TextBlock Text="스캔 제외 (한 줄에 하나)" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding ExclusionText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="ExclusionPatterns"
                             AcceptsReturn="True" TextWrapping="NoWrap" Height="86" Margin="0,3,0,4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             ToolTip="*.tmp = 확장자 (파일만)&#x0a;node_modules, ~$* = 이름 (파일·폴더, 깊이 무관)&#x0a;.git = 그 이름의 폴더 + 그 확장자의 파일&#x0a;C:\Windows\Temp, obj\Debug = 경로 (폴더 하위 전체)&#x0a;# 로 시작하면 주석" />
                    <TextBlock Text="{Binding ExclusionSummary}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <Button Content="제외 규칙 적용" Command="{Binding ApplyExclusionsCommand}"
                            AutomationProperties.AutomationId="ApplyExclusions" Margin="0,0,0,6" />

                    <Separator Margin="0,12" />
                    <Button Content="CSV 내보내기" Click="OnExportCsv" Margin="0,0,0,6" />
                    <Button Content="JSON 내보내기" Click="OnExportJson" Margin="0,0,0,6" />
                    <Button Content="캐시 삭제" Command="{Binding ClearCacheCommand}" Margin="0,0,0,6" />
                    <Button Content="단축키 설정..." Click="OnOpenShortcutSettings"
                            AutomationProperties.AutomationId="OpenShortcutSettings"
                            ToolTip="기능별 단축키를 확인하고 바꿉니다" />
                </StackPanel>
            </Border>

            <!-- ========== 43. 개발용 성능 모니터 ========== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Width="272" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,10,10" Opacity="0.97"
                    Visibility="{Binding ShowPerfMonitor, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Performance Monitor" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Scan Mode" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusMode}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="1" Text="Elapsed" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProgressElapsed}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="2" Text="Files/sec" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProgressSpeed}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="3" Text="Directories/sec" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PerfDirsPerSec}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="4" Text="Worker Count" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PerfWorkers}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="5" Text="Directory Queue" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PerfDirQueue}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="6" Text="Result Queue" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PerfResultQueue}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="7" Text="Managed Memory" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PerfMemory}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="8" Text="Peak Memory" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PerfPeakMemory}" Style="{StaticResource Numeric}" FontSize="11.5" />

                        <TextBlock Grid.Row="9" Text="UI Update Latency" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding PerfUiLatency}" Style="{StaticResource Numeric}" FontSize="11.5" />
                    </Grid>
                    <TextBlock Text="{Binding PerfStoreMemory, StringFormat=Node Store: {0}}"
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
